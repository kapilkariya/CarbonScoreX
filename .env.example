# Local inference provider used by recommendation and Net Zero planning.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000

# Backend running directly on Windows:
OLLAMA_BASE_URL=http://localhost:11434

# When running the backend in Docker Desktop, use this instead:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional provider if you intentionally choose Gemini instead of Ollama:
GEMINI_API_KEY=
